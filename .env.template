# Telegram-бот
BOT__TOKEN=
# Общий таймаут RAG: поиск, очередь и генерация.
# BOT__REQUEST_TIMEOUT_S=120
# Таймаут одного запроса к Telegram и максимальное ожидание перед повтором при 429.
# BOT__TELEGRAM_TIMEOUT_S=15
# BOT__TELEGRAM_RETRY_AFTER_S=5
# Необязательно: путь к локальной базе оценок (по умолчанию data/feedback.sqlite3).
# BOT__FEEDBACK_DB_PATH=/absolute/path/to/feedback.sqlite3
# Контакты для кнопки «Контакты»: JSON-список строк. Реальные данные только в .env.
# BOT__DEVELOPERS='["Автор 1 — @username1", "Автор 2 — @username2"]'
BOT__DEVELOPERS=[]

# Qdrant
QDRANT__URL=http://localhost:6333
QDRANT__API_KEY=

# LLM
# provider: ollama | openai (любой OpenAI-совместимый сервер: OpenAI, vLLM, облака)
LLM__PROVIDER=ollama
LLM__BASE_URL=http://localhost:11434
LLM__MODEL=qwen2.5:7b-instruct
LLM__API_KEY=
# LLM__TEMPERATURE=0.2
# LLM__MAX_TOKENS=1024
# LLM__TIMEOUT_S=60
# LLM__MAX_CONCURRENCY=1   # 1 — локальный GPU, запросы к LLM по очереди

# Логирование
# LOG__LEVEL=INFO
