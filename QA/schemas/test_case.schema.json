{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Berserk AI QA Gold Test Case",
  "type": "object",
  "required": [
    "test_id",
    "dataset_version",
    "split",
    "category",
    "subcategory",
    "difficulty",
    "priority",
    "question",
    "expected_answer",
    "expected_facts",
    "answerability",
    "intent",
    "retrieval_target",
    "expected_source_ids",
    "citation_required",
    "temporal",
    "status"
  ],
  "properties": {
    "test_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "dataset_version": {
      "type": "string"
    },
    "split": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Rules_Basic",
        "Mechanics_Glossary",
        "Cards_Facts",
        "Card_FAQ_Interactions",
        "Tournament_Formats",
        "Negative_OutOfScope"
      ]
    },
    "subcategory": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "expected_answer": {
      "type": "string",
      "minLength": 1
    },
    "expected_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_claims": {
      "type": "string"
    },
    "answerability": {
      "type": "string",
      "enum": [
        "answerable",
        "unanswerable"
      ]
    },
    "intent": {
      "type": "string"
    },
    "retrieval_target": {
      "type": "string"
    },
    "expected_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "citation_required": {
      "type": "string",
      "enum": [
        "Да",
        "Нет"
      ]
    },
    "temporal": {
      "type": "string",
      "enum": [
        "Да",
        "Нет"
      ]
    },
    "snapshot_date": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_RUN",
        "RUNNING",
        "DONE"
      ]
    },
    "actual_answer": {
      "type": "string"
    },
    "actual_sources": {
      "type": "string"
    },
    "judge_result": {
      "type": "string",
      "enum": [
        "",
        "PASS",
        "PARTIAL",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "judge_comment": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
